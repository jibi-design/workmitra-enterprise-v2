# ==============================================================================
# JOB MITRA | .cursorignore
# Purpose: max Cursor performance + security — skip heavy/generated/secret files.
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.pnp/
.pnp.*

# Framework / build outputs (Vite + any Next leftovers)
.next/
dist/
dev-dist/
build/
out/
coverage/
.cache/
.vite/
node_modules/.vite/
temp/
_dev_backups/

# Environment / secrets (never index)
.env
.env.*
.env.local
.env*.local
*.jks
*.keystore
*.p12
*.pem
*.key
*.crt
credentials.json
service-account.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / report artifacts (heavy)
playwright-report/
test-results/
blob-report/

# Mobile generated
android/
ios/
.gradle/

# Archives / media
*.zip
*.7z
*.rar
*.tar
*.gz
*.mp4
*.mov
*.avi

# OS noise
.DS_Store
Thumbs.db

# Local generated dumps / lab Chrome / agent scratch (Cursor OOM: do not index)
.tmp/
employee_tree.txt
