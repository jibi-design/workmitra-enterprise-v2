# Job Mitra - environment variables
# Copy to .env and fill in real values. Do not commit .env — only this file.

# ─── Database (required for DB mode and all career lifecycle endpoints) ───────
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ─── Auth session security (required in production) ──────────────────────────
# WM_SESSION_HASH_PEPPER=<32+ random chars>
# AUTH_USER_SOURCE=db     # 'db' for production/DB mode, omit for memory/demo mode

# ─── Career lifecycle seed (used by npm run db:seed and db:seed:career) ───────
# SEED_EMPLOYEE_EMAIL=employee@staging.jobmitra.app
# SEED_EMPLOYER_EMAIL=employer@staging.jobmitra.app
# SEED_EMPLOYEE_PASSWORD=<staging password>
# SEED_EMPLOYER_PASSWORD=<staging password>

# --- Frontend (Vite) ---
# VITE_AUTH_BACKEND_ENABLED=true
# Alternative: npm run dev:auth

# VITE_API_URL=

# --- API server (Node) ---
# PORT=3001
# NODE_ENV=production  -> demo off, Secure cookie, WM_ALLOW_DEMO_AUTH=true is fatal
# WM_ALLOW_DEMO_AUTH=false  -> disable demo login in development

# CORS whitelist (comma-separated, no trailing slash)
# Dev default: http://localhost:5173,http://localhost:4173
# WM_ALLOWED_ORIGINS=https://workmitra.app,https://app.workmitra.com
