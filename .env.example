# Job Mitra / WorkMitra Enterprise v2 — environment template
# Copy to .env.local for Vite. Never commit real secrets.

# ---------------------------------------------------------------------------
# Shift Ops (Option A — Supabase greenfield) Phase 0–1
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server / Edge only (NOT for Vite client — use Supabase secrets / Edge env)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# SHIFT_OPS_CHANNEL_PEPPER=long-random-pepper-replace-in-vault

# After migrate, set DB pepper (service role / SQL editor):
#   update shift_ops.config set value = '<pepper>' where key = 'channel_pepper';

# Phase 3 Calling (server only — never expose to Vite client)
# Fill real values in .env locally / deploy secrets. Leave blank until LIVE_JOIN_READY=YES.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_NUMBER=

# Phase 3 Calling — no-answer fallback job (server / cron only)
# CALL_NO_ANSWER_MS=30000
# CALL_FALLBACK_DRY_RUN=true
# CALL_FALLBACK_DEST_JSON={"ML-EXAMPLE":"+440000000000"}
