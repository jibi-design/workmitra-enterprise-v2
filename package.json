{
  "name": "workmitra-enterprise-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:auth": "vite --mode auth",
    "dev:db": "node scripts/with-auth-db-source.mjs server/index.ts",
    "db:migrate": "node scripts/with-auth-db-source.mjs server/db/migrate.ts",
    "db:seed": "node scripts/with-auth-db-source.mjs server/db/seed.ts",
    "db:seed:career": "node scripts/with-auth-db-source.mjs server/db/seed.career.ts",
    "db:seed:play-reviewer": "node scripts/seed-play-store-reviewer.mjs",
    "job:gap-retention": "node scripts/with-auth-db-source.mjs scripts/run-gap-retention-jobs.ts",
    "job:gap-retention:cron": "node scripts/with-auth-db-source.mjs scripts/gap-retention-cron-entry.ts",
    "job:call-fallback": "node scripts/with-auth-db-source.mjs scripts/run-call-fallback-job.ts",
    "dev:host": "vite --host",
    "build": "tsc -b && node scripts/assert-production-build-env.mjs && vite build && node scripts/verify-build-chunks.mjs",
    "assets:android": "node scripts/generate-android-brand-assets.mjs",
    "build:mobile": "npm run assets:android && npm run build && npx cap sync",
    "assert:android-release": "node scripts/assert-android-release.mjs",
    "assert:capacitor-smoke": "node scripts/assert-capacitor-device-smoke.mjs",
    "assert:pulse-integrity": "node scripts/assert-pulse-layout-integrity.mjs",
    "audit:device-local-storage": "node scripts/audit-device-local-storage.mjs",
    "bundle:android": "node scripts/bundle-android-release.mjs",
    "check:build-integrity": "node scripts/verify-build-chunks.mjs",
    "check:migration-integrity": "node scripts/check-migration-integrity.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --ui",
    "test:e2e:headless": "playwright test",
    "test:e2e:visual-walkthrough": "playwright test --project=chromium --headed tests/e2e/visual-e2e-shift-walkthrough.spec.ts",
    "test:e2e:visual-stress": "playwright test --config=playwright.visual-stress.config.ts --project=chromium-visual-stress",
    "test:e2e:cdp": "playwright test --project=chromium tests/e2e/shift-cdp-benchmark.spec.ts",
    "test:security": "node tests/security/rate-limit.probe.mjs && node tests/security/pii-isolation.probe.mjs",
    "test:load:k6": "node tests/load/run-shift-load.mjs",
    "test:load:node": "node tests/load/node-shift-chaos-fanout.mjs",
    "test:load:store-stress": "node tests/load/run-store-submission-stress.mjs",
    "test:load:store-stress:auth": "npx tsx tests/load/provision-and-run-auth-stress.ts",
    "test:load:lab-110": "npx tsx tests/load/provision-lab-110.ts",
    "test:sim:zero-pending": "npx tsx tests/load/run-zero-pending-sim.ts",
    "test:failover": "vitest run src/tests/shiftRetryQueue.failover.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "export:context": "node scripts/export-context.js",
    "analyze": "vite-bundle-visualizer",
    "check:security": "npm audit --audit-level=high",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint src --max-warnings 0",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:dead": "knip",
    "check:pulse": "tsc --noEmit && eslint src/features/pulse/ --max-warnings 0",
    "preflight": "npm run check:security && npm run check:types && npm run check:lint && npm run check:circular && npm run build",
    "preflight:full": "npm run preflight && npm run check:dead",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-virtual": "^3.14.7",
    "agora-rtc-sdk-ng": "^4.24.6",
    "agora-token": "^2.0.5",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sanitize-html": "^2.17.6",
    "twilio": "^6.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@million/lint": "^1.0.14",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.23.0",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  }
}
