{
  "name": "workmitra-enterprise-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:auth": "vite --mode auth",
    "dev:db": "node scripts/with-auth-db-source.mjs server/index.ts",
    "db:migrate": "node scripts/with-auth-db-source.mjs server/db/migrate.ts",
    "db:seed": "node scripts/with-auth-db-source.mjs server/db/seed.ts",
    "db:seed:career": "node scripts/with-auth-db-source.mjs server/db/seed.career.ts",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "build:mobile": "npm run build && npx cap sync",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --ui",
    "test:e2e:headless": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "export:context": "node scripts/export-context.js",
    "analyze": "vite-bundle-visualizer",
    "check:security": "npm audit --audit-level=high",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint src --max-warnings 0",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:dead": "knip",
    "check:pulse": "tsc --noEmit && eslint src/features/pulse/ --max-warnings 0",
    "preflight": "npm run check:security && npm run check:types && npm run check:lint && npm run check:circular && npm run build",
    "preflight:full": "npm run preflight && npm run check:dead",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@node-rs/argon2": "^2.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@million/lint": "^1.0.14",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.23.0",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  }
}
